{
  "name": "exxonmobil-position-preference",
  "version": "1.0.0",
  "private": true,
  "description": "Candidate Position Preference Selection Platform — ExxonMobil Affiliates in Nigeria (Dragnet Solutions)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx scripts/seed.ts",
    "seed:positions": "tsx scripts/seedPositions.ts",
    "backfill:sent": "tsx scripts/backfillSentAt.ts",
    "tokens:issue": "tsx scripts/issueTokens.ts",
    "email:send": "tsx scripts/sendEmails.ts",
    "email:preview": "tsx scripts/previewEmail.ts",
    "admin:create": "tsx scripts/createAdmin.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/formbody": "^8.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.1",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
