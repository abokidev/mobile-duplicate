# ── Database ────────────────────────────────────────────────────────────────
# MySQL, consistent with Project ATLAS.
DATABASE_URL="mysql://app:app_pw@127.0.0.1:3306/pospref"
# Separate database used by the concurrency test suite (npm test).
TEST_DATABASE_URL="mysql://app:app_pw@127.0.0.1:3306/pospref_test"

# ── Tokens ──────────────────────────────────────────────────────────────────
# Secret key for HMAC-SHA256 token hashing (FR1). Keep out of source control.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_HMAC_SECRET="change-me-to-a-long-random-value"

# ── Public URL ────────────────────────────────────────────────────────────────
# Base URL the tokenised links are built from (HTTPS only in production).
PUBLIC_BASE_URL="https://select.dragnet-solutions.com"

# ── Server ────────────────────────────────────────────────────────────────────
PORT="3000"
HOST="0.0.0.0"
# Secret used to sign admin session cookies.
COOKIE_SECRET="change-me-to-a-long-random-value"
# Set to "true" only behind a trusted HTTPS proxy so secure cookies are sent.
COOKIE_SECURE="false"
# Trust X-Forwarded-* headers (set true behind a reverse proxy / load balancer).
TRUST_PROXY="false"

# ── Email — ZeptoMail (HTTP API) ─────────────────────────────────────────────
# HTTP API (api.zeptomail.com), NOT SMTP. All five are REQUIRED by the send
# script — it fails loudly on startup if any is missing (no hardcoded default).
ZEPTOMAIL_API_HOST="api.zeptomail.com"
ZEPTOMAIL_AGENT_ALIAS="your-mail-agent-alias"
# The full Authorization header value — already includes the "Zoho-enczapikey "
# prefix. Sensitive: set locally only, never commit.
ZEPTOMAIL_SEND_TOKEN="Zoho-enczapikey your-send-mail-token"
SENDER_EMAIL="noreply@dragnet-solutions.com"
SENDER_NAME="Dragnet Solutions Limited"
# Optional reply-to for candidate questions.
EMAIL_REPLY_TO="support@dragnet-solutions.com"

# ── SMS — Termii (HTTP API v4) ───────────────────────────────────────────────
# Required only for SMS reminders. TERMII_API_KEY is sensitive — set locally, never commit.
TERMII_API_KEY="your-termii-api-key"
# This account is on v4 — do NOT use an older api.ng.termii.com host.
TERMII_BASE_URL="https://v4.api.termii.com"
# Registered/approved sender ID.
TERMII_SENDER_ID="Dragnet"

# ── Copy / deadline (Deadline Addendum: this is COPY ONLY, never enforced) ────
# Moving the deadline is a text change here — no code or token changes needed.
DEADLINE_DISPLAY="4:00 PM WAT, Thursday 20 August 2026"
TEST_DATE_DISPLAY="Saturday, 29 August 2026"
