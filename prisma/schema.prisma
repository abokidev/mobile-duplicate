// Prisma schema — Candidate Position Preference Selection Platform
// ExxonMobil Affiliates in Nigeria (via Dragnet Solutions Limited)
// Stack: Node.js/TypeScript, Fastify, Prisma, MySQL — consistent with Project ATLAS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Multi-shortlisted candidates reached only via an emailed tokenised link.
model Candidate {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  /// Optional — for SMS reminders (Termii). Populated via the main upload's
  /// optional `phone` column or the separate phone re-upload.
  phoneNumber String?  @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at")

  shortlist Shortlist[]
  token     Token?
  selection Selection?

  @@map("candidates")
}

/// The 7 fixed positions on offer.
model Position {
  id    Int    @id @default(autoincrement())
  title String @unique

  shortlist Shortlist[]
  selection Selection[]

  @@map("positions")
}

/// Many-to-many map defining which positions a candidate may ever see.
/// Server-side position visibility (FR2) is derived only from these rows.
model Shortlist {
  candidateId Int @map("candidate_id")
  positionId  Int @map("position_id")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  position  Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([candidateId, positionId])
  @@index([positionId])
  @@map("shortlist")
}

enum TokenStatus {
  unused
  used
}

/// One token per multi-shortlisted candidate. Only the salted HMAC-SHA256 hash
/// is stored (FR1). The raw token exists only in the emailed URL. Per the
/// Deadline Addendum, tokens never expire — the only states are unused/used.
model Token {
  id          Int         @id @default(autoincrement())
  candidateId Int         @unique @map("candidate_id")
  tokenHash   String      @unique @map("token_hash")
  status      TokenStatus @default(unused)
  usedAt      DateTime?   @map("used_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  /// Encrypted (AES-256-GCM) copy of the RAW token, retained ONLY so the admin
  /// can run the separated send and same-link reminders after import, and retry
  /// failed sends. Purged (set null) the moment the candidate submits. The
  /// authoritative lookup path is always the salted hash above; this is never
  /// used for verification. See src/lib/crypto.ts and the Admin Upload addendum.
  deliveryEnc        String?   @map("delivery_enc") @db.Text
  /// Authoritative "has been emailed" marker, written in the send batch. This is
  /// the source of truth for send status and for deciding who still needs sending
  /// — NOT the best-effort `sent` Event — so a tracking hiccup can never cause a
  /// re-send (duplicate email) or a wrong "Not sent" on the dashboard.
  sentAt       DateTime? @map("sent_at")
  /// Which message template was used for the send (message_1 / message_2).
  sentTemplate String?   @map("sent_template")

  /// Manual reminder bookkeeping (admin-initiated; no scheduler).
  reminderCount      Int       @default(0) @map("reminder_count")
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  events    Event[]

  @@map("tokens")
}

enum EventType {
  sent
  send_failed
  sms_sent
  sms_failed
  opened
  page_visited
  submitted
}

/// Per-token delivery/engagement timeline (Admin Upload addendum §2).
model Event {
  id         Int       @id @default(autoincrement())
  tokenId    Int       @map("token_id")
  type       EventType
  /// Free text: error message for send_failed, etc.
  detail     String?   @db.Text
  /// Which invitation copy was used on a `sent` event ("message_1"/"message_2").
  messageTemplate String? @map("message_template")
  occurredAt DateTime  @default(now()) @map("occurred_at")

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([type])
  @@map("events")
}

/// One selection per candidate, ever. Written inside the same locked
/// transaction that flips the token used (FR4). Includes audit trail (FR7).
model Selection {
  id          Int      @id @default(autoincrement())
  candidateId Int      @unique @map("candidate_id")
  positionId  Int      @map("position_id")
  selectedAt  DateTime @default(now()) @map("selected_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.Text
  /// How the selection was recorded: "candidate" (via the web flow) or
  /// "auto_single_shortlist" (FR6 — single-position candidates, never emailed).
  source      String   @default("candidate")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  position  Position  @relation(fields: [positionId], references: [id])

  @@index([positionId])
  @@map("selections")
}

/// Admin dashboard user. Stand-in for Dragnet's existing admin auth (FR9);
/// swap the credential check for the shared ATLAS auth mechanism in production.
model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String   @id
  adminId   Int      @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}
